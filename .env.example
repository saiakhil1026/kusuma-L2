# NexusMatrix Environment Variables

# Langfuse Observability (Kusuma L2 API Keys)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL=https://aidev.3ecompany.com

# Qdrant Vector Database (Replaces Supabase)
QDRANT_URL=https://your-qdrant-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Express API Server Port
PORT=3002
