# NexusMatrix Environment Variables

# Google Gemini API Keys (Target Models: gemini-3.7-flash and gemini-3.1-pro-preview)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Vector DB Configuration
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Connection String (Use SSL with valid certificates)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Express API Server Port
PORT=3001

